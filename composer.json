{
    "name": "commerce/module-cache-tools",
    "description": "Cache tooling for Magento 2: queue-driven product cache warming with run tracking, Fastly/Varnish purging with environment guards, and edge health checks.",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kingletas/magento2-module-foundation"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kingletas/magento2-module-logger"
        }
    ],
    "require": {
        "php": ">=8.4",
        "commerce/module-foundation": "^1.0",
        "magento/framework": ">=103.0",
        "magento/module-backend": ">=102.0",
        "magento/module-catalog": ">=104.0",
        "magento/module-catalog-url-rewrite": ">=100.4",
        "magento/module-configurable-product": ">=100.4",
        "magento/module-store": ">=101.1",
        "magento/module-ui": ">=101.2",
        "magento/module-url-rewrite": ">=102.0"
    },
    "suggest": {
        "fastly/fastly": "Required for edge purging and service discovery (^13.1).",
        "colinmollenhour/credis": "Required for SKU-keyed cache purging; ships with Magento's Redis cache backend.",
        "magento/module-swatches": "Required to warm the default swatch renderer cache."
    },
    "require-dev": {
        "fastly/fastly": "^13.1",
        "magento/magento-coding-standard": ">=38 <42",
        "magento/module-swatches": ">=100.4",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "slevomat/coding-standard": "^8.15"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Commerce\\CacheTools\\": ""
        },
        "exclude-from-classmap": [
            "/Test/"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "laminas/laminas-dependency-plugin": true,
            "magento/*": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
        "cs": "phpcs --standard=phpcs.xml.dist",
        "cs-fix": "phpcbf --standard=phpcs.xml.dist",
        "stan": "phpstan analyse --configuration phpstan.neon.dist --no-progress",
        "md": "phpmd Api,Console,Controller,Cron,Lock,Model,Observer,Queue,Ui,ViewModel text phpmd.xml.dist",
        "test": "phpunit --configuration phpunit.xml.dist",
        "test-wiring": "phpunit --configuration phpunit.xml.dist --testsuite wiring",
        "test-behaviour": "phpunit --configuration phpunit.xml.dist --testsuite behaviour",
        "test-performance": "phpunit --configuration phpunit.xml.dist --testsuite performance",
        "test-unit": "phpunit --configuration phpunit.xml.dist --testsuite unit",
        "check": [
            "@lint",
            "@cs",
            "@stan",
            "@md",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "check": "Everything the CI pull-request gate runs, except the integration suite.",
        "test": "Every suite this module ships. Needs M2_VENDOR pointing at a Magento installation's vendor directory."
    }
}
