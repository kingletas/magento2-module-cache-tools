<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="commerce_cachetools" translate="label" type="text" sortOrder="900"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>Cache Tools</label>
            <tab>advanced</tab>
            <resource>Commerce_CacheTools::config</resource>

            <group id="environment" translate="label comment" type="text" sortOrder="5" showInDefault="1">
                <label>Environment Safety</label>
                <comment><![CDATA[<strong>Read this before enabling purging.</strong> A stage deployment
                    restored from a production database carries production's Fastly credentials and can flush
                    production's cache. These settings are how the module tells the two apart.]]></comment>
                <field id="production_host" translate="label comment" type="text" sortOrder="10" showInDefault="1">
                    <label>Production Host</label>
                    <comment><![CDATA[The production site's hostname, e.g. <code>www.example.com</code>.
                        Leave blank and this deployment is treated as non-production, refusing service-wide
                        purges. Production additionally requires
                        <code>commerce/cache_tools/environment</code> to be set to
                        <code>production</code> in <code>app/etc/env.php</code> — a file that is not
                        overwritten when a production database is refreshed down to stage.]]></comment>
                </field>
                <field id="non_production_marker" translate="label comment" type="text" sortOrder="20" showInDefault="1">
                    <label>Non-Production Service Marker</label>
                    <comment>A Fastly service whose name contains this string is treated as a lower environment.</comment>
                </field>
            </group>

            <group id="fastly" translate="label" type="text" sortOrder="10" showInDefault="1">
                <label>Edge Cache (Fastly)</label>
                <field id="enable" translate="label" type="select" sortOrder="10" showInDefault="1" canRestore="1">
                    <label>Enable Purging</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="token" translate="label comment" type="obscure" sortOrder="20" showInDefault="1">
                    <label>API Token</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Stored encrypted.</comment>
                    <depends><field id="enable">1</field></depends>
                </field>
                <field id="service_id" translate="label comment" type="obscure" sortOrder="30" showInDefault="1">
                    <label>Service ID</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Optional. Leave blank to discover it from the service name below.</comment>
                    <depends><field id="enable">1</field></depends>
                </field>
                <field id="service_name" translate="label comment" type="text" sortOrder="40" showInDefault="1">
                    <label>Service Name</label>
                    <comment>Used to discover the service ID, and by the environment guard.</comment>
                    <depends><field id="enable">1</field></depends>
                </field>
                <field id="soft_purge" translate="label comment" type="select" sortOrder="50"
                       showInDefault="1" canRestore="1">
                    <label>Soft Purge by Default</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[Soft purges mark objects stale rather than evicting them, so shoppers keep
                        getting a fast response while the origin revalidates. A hard purge on a busy catalogue
                        sends every concurrent request to origin at once.]]></comment>
                    <depends><field id="enable">1</field></depends>
                </field>
                <field id="purge_strategy" translate="label comment" type="select" sortOrder="60" showInDefault="1">
                    <label>Purge Strategy on Product Save</label>
                    <source_model>Commerce\CacheTools\Model\Source\PurgeStrategy</source_model>
                    <comment>Surrogate keys need the CDN configured to emit Magento's cache tags.</comment>
                    <depends><field id="enable">1</field></depends>
                </field>
                <field id="extra_urls" translate="label comment" type="textarea" sortOrder="70" showInDefault="1">
                    <label>Additional Cache URLs</label>
                    <comment>Comma-separated. Offered alongside store base URLs on the Cache Management page.</comment>
                    <depends><field id="enable">1</field></depends>
                </field>
            </group>

            <group id="warmer" translate="label" type="text" sortOrder="20" showInDefault="1">
                <label>Cache Warming</label>
                <field id="simple_batch_size" translate="label" type="text" sortOrder="10"
                       showInDefault="1" canRestore="1">
                    <label>Simple Products per Message</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="configurable_batch_size" translate="label" type="text" sortOrder="20"
                       showInDefault="1" canRestore="1">
                    <label>Configurable Products per Message</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="stale_run_hours" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" canRestore="1">
                    <label>Reap Runs After (hours without progress)</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <comment><![CDATA[Measured from the last progress update, not from the start, so a long warm
                        is never killed mid-flight. Only one run per product type may be open at a time, so a run
                        stuck by a lost message would otherwise block every future run.]]></comment>
                </field>
            </group>
        </section>
    </system>
</config>
