# Static analysis needs the Magento classes on the autoloader, so this is only
# runnable where `composer install` has resolved magento/framework. The CI job
# that runs it is gated on those credentials being present rather than being
# allowed to pass vacuously.
parameters:
    level: 6
    # Registers the on-demand generator, so a Factory that only exists
    # after `setup:di:compile` resolves here too.
    bootstrapFiles:
        - Test/generated-classes.php
    paths:
        - Api
        - Console
        - Controller
        - Cron
        - Lock
        - Model
        - Observer
        - Queue
        - Ui
        - ViewModel
    excludePaths:
        - Test/*
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # adminhtml configures Result\\PageFactory with the backend Page, which is
        # where setActiveMenu lives; core's own grids call it exactly this way.
        -
            message: '#Call to an undefined method Magento\\Framework\\View\\Result\\Page::setActiveMenu\(\)#'
            path: Controller/Adminhtml/WarmRun/Index.php
            # The framework's docblock varies across the versions this package supports.
            reportUnmatched: false
        # __() returns a Phrase, and Magento's own controllers hand one to this
        # API; the parameter is documented as string and never was.
        -
            message: '#of method Magento\\Framework\\View\\Page\\Title::(set|prepend)\(\) expects string, Magento\\Framework\\Phrase given#'
            # The framework's docblock varies across the versions this package supports.
            reportUnmatched: false
